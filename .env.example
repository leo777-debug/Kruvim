# ---- required in production ---------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
KRUVIM_SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me
KRUVIM_PUBLIC_URL=http://localhost:8080
KRUVIM_CORS_ORIGINS=http://localhost:8080
KRUVIM_HTTP_PORT=8080

# First platform administrator (created on first start). Leave empty to make the first sign-up the admin.
KRUVIM_FIRST_SUPERUSER_EMAIL=
KRUVIM_FIRST_SUPERUSER_PASSWORD=
KRUVIM_ALLOW_REGISTRATION=true

# ---- platform model provider (optional) ------------------------------------------------------
# Leave blank: every organisation runs in dry-run until it adds its own key (Settings → Model provider),
# or a platform admin sets a shared key (Admin → Platform provider). Shared-key usage is metered in credits.
KRUVIM_LLM_PROVIDER=dryrun
KRUVIM_LLM_PRESET=dryrun
KRUVIM_LLM_BASE_URL=
KRUVIM_LLM_API_KEY=
KRUVIM_LLM_VOICE_MODEL=
KRUVIM_LLM_REPORT_MODEL=
KRUVIM_LLM_VISION_MODEL=
KRUVIM_LLM_CONCURRENCY=8

# ---- data pool credentials (all optional; keyless sources work without them) -----------------
KRUVIM_REDDIT_CLIENT_ID=
KRUVIM_REDDIT_CLIENT_SECRET=
KRUVIM_YOUTUBE_API_KEY=
KRUVIM_X_BEARER_TOKEN=
KRUVIM_BLUESKY_HANDLE=
KRUVIM_BLUESKY_APP_PASSWORD=

# ---- scale & limits ----------------------------------------------------------------------------
KRUVIM_POPULATION_SIZE=1000000
KRUVIM_WORKER_MAX_JOBS=4
WEB_CONCURRENCY=2
KRUVIM_RATE_LIMIT_PER_MINUTE=240
KRUVIM_MAX_UPLOAD_MB=500

# ---- object storage (optional S3-compatible; default is the shared volume) ----------------------
KRUVIM_STORAGE_BACKEND=local
KRUVIM_S3_BUCKET=
KRUVIM_S3_ENDPOINT_URL=
KRUVIM_S3_REGION=
