# ---- required in production ---------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
KRUVIM_SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me
KRUVIM_PUBLIC_URL=http://localhost:8080
KRUVIM_CORS_ORIGINS=http://localhost:8080
KRUVIM_HTTP_PORT=8080

# First platform administrator (created on first start). Leave empty to make the first sign-up the admin.
KRUVIM_FIRST_SUPERUSER_EMAIL=
KRUVIM_FIRST_SUPERUSER_PASSWORD=
# Invite-only beta: new people join through workspace invites. Set true only for an open sign-up.
KRUVIM_ALLOW_REGISTRATION=false
# Reverse proxies in front of the API (the bundled nginx counts as 1; add one per load balancer).
KRUVIM_FORWARDED_HOPS=1
# When rotating KRUVIM_SECRET_KEY, list the old value here, deploy, then run: python -m scripts.rotate_secrets
KRUVIM_PREVIOUS_SECRET_KEYS=

# ---- platform model provider (optional) ------------------------------------------------------
# Leave blank: every organisation runs in dry-run until it adds its own key (Settings → Model provider),
# or a platform admin sets a shared key (Admin → Platform provider). Shared-key usage is metered in credits.
KRUVIM_LLM_PROVIDER=dryrun
KRUVIM_LLM_PRESET=dryrun
KRUVIM_LLM_BASE_URL=
KRUVIM_LLM_API_KEY=
KRUVIM_LLM_VOICE_MODEL=
KRUVIM_LLM_REPORT_MODEL=
KRUVIM_LLM_VISION_MODEL=
KRUVIM_LLM_CONCURRENCY=8
# Local model servers (Ollama, LM Studio, vLLM, the compose `ollama` service) need private addresses.
# Only enable on a self-hosted install: on a shared server it lets workspace admins reach internal services.
KRUVIM_ALLOW_PRIVATE_MODEL_URLS=false

# ---- spending limits (hard stops checked before every model call; 0 = no limit) ----------------------
# Calls per UTC day on the platform key above, across all workspaces, and per workspace.
KRUVIM_PLATFORM_DAILY_CALL_LIMIT=20000
KRUVIM_ORG_DAILY_CALL_LIMIT=3000
# Any single job, any key; a run may use this multiple of its estimate before it is stopped.
KRUVIM_JOB_MAX_LLM_CALLS=20000
KRUVIM_RUN_CALL_CAP_FACTOR=1.5
# Per-user request limits on expensive endpoints.
KRUVIM_RATE_LIMIT_EXPENSIVE_PER_MINUTE=20
KRUVIM_RATE_LIMIT_RUNS_PER_HOUR=30
KRUVIM_RATE_LIMIT_UPLOADS_PER_HOUR=60

# ---- data pool credentials (all optional; keyless sources work without them) -----------------
KRUVIM_REDDIT_CLIENT_ID=
KRUVIM_REDDIT_CLIENT_SECRET=
KRUVIM_YOUTUBE_API_KEY=
KRUVIM_X_BEARER_TOKEN=
KRUVIM_BLUESKY_HANDLE=
KRUVIM_BLUESKY_APP_PASSWORD=

# Creator-owned analytics: register OAuth apps and their exact callbacks first.
# Callback: KRUVIM_PUBLIC_URL/api/v1/social/{youtube|tiktok|instagram}/callback
# Public URL must route /api to the backend (Vite/nginx already do this).
KRUVIM_YOUTUBE_CLIENT_ID=
KRUVIM_YOUTUBE_CLIENT_SECRET=
KRUVIM_TIKTOK_CLIENT_ID=
KRUVIM_TIKTOK_CLIENT_SECRET=
KRUVIM_INSTAGRAM_CLIENT_ID=
KRUVIM_INSTAGRAM_CLIENT_SECRET=
KRUVIM_INSTAGRAM_API_VERSION=v25.0
KRUVIM_SOCIAL_SYNC_MINUTES=60
KRUVIM_ACCURACY_MIN_TESTS=20
KRUVIM_ACCURACY_MIN_WORKSPACES=3
KRUVIM_SOURCE_WEIGHT_MIN_TESTS=20
KRUVIM_EMBEDDING_MODEL=
KRUVIM_EMBEDDING_PRICE_PER_MILLION=
KRUVIM_CONNECTOR_CONCURRENCY=3
KRUVIM_CONNECTOR_MIN_INTERVAL_SECONDS={"gdelt":10,"reddit":2}
KRUVIM_SNAPSHOT_ARCHIVE_DAYS=30
KRUVIM_SIGNAL_MAX_AGE_HOURS={"weather":1,"headline":3,"tone":3,"trend":6,"social_trend":6,"event":24,"economy":24}

# ---- scale & limits ----------------------------------------------------------------------------
KRUVIM_POPULATION_SIZE=1000000
KRUVIM_WORKER_MAX_JOBS=4
WEB_CONCURRENCY=2
KRUVIM_RATE_LIMIT_PER_MINUTE=240
KRUVIM_MAX_UPLOAD_MB=500

# ---- object storage (optional S3-compatible; default is the shared volume) ----------------------
KRUVIM_STORAGE_BACKEND=local
KRUVIM_S3_BUCKET=
KRUVIM_S3_ENDPOINT_URL=
KRUVIM_S3_REGION=
